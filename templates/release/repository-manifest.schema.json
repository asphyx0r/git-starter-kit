{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Release Inventory Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "release_kind",
    "version",
    "release_date",
    "artifact"
  ],
  "properties": {
    "manifest_version": {
      "const": "3.0.0"
    },
    "release_kind": {
      "const": "repository"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "release_date": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "files",
        "total_files",
        "size_bytes",
        "sha256",
        "built_at"
      ],
      "properties": {
        "format": {
          "const": "git-tree"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileEntry"
          }
        },
        "total_files": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "built_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^[\\\\/]"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:[\\\\/]"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "file_type",
        "line_ending",
        "encoding",
        "sha256",
        "mode"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "file_type": {
          "type": "string",
          "enum": [
            "text",
            "binary"
          ]
        },
        "line_ending": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "LF",
            "CRLF",
            "CR",
            null
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-7]{3,4}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "file_type": {
                "const": "binary"
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "properties": {
              "line_ending": {
                "type": "null"
              },
              "encoding": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "file_type": {
                "const": "text"
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "properties": {
              "encoding": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
