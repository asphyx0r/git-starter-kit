[codespell]
check-hidden =
check-filenames =
ignore-words-list = ans,statics
skip = .git,dist,build,out,target,coverage,htmlcov,reports,test-output,test-results,logs,log,var,pids,.tmp,tmp,temp,node_modules,vendor,.venv,venv,.tox,.cache,.mypy_cache,.pytest_cache,.ruff_cache,.nox,.pyre,.hypothesis,.ipynb_checkpoints,.idea,.superpowers,.phpunit.result.cache,.phpunit.cache,.php-cs-fixer.cache,*git-commit-push-tag.txt,*git-starter-kit-release-package.txt,*.bak,*.old,*.tmp,*.temp,*.log,*.err,*.out,*.pid,*.lock,*package-lock.json,*.min.js,*.map,*.svg,*.png,*.jpg,*.jpeg,*.gif,*.pdf,*.7z,*.gz,*.rar,*.tar,*.tar.gz,*.tgz,*.zip
