#!/usr/bin/env bash
set -euo pipefail

zero_object_id='0000000000000000000000000000000000000000'
semver_tag_pattern='^v(0|[1-9][0-9]*)\.'
semver_tag_pattern+='(0|[1-9][0-9]*)\.'
semver_tag_pattern+='(0|[1-9][0-9]*)'
semver_tag_pattern+='(-((0|[1-9][0-9]*|[0-9A-Za-z-]*'
semver_tag_pattern+='[A-Za-z-][0-9A-Za-z-]*)'
semver_tag_pattern+='(\.(0|[1-9][0-9]*|[0-9A-Za-z-]*'
semver_tag_pattern+='[A-Za-z-][0-9A-Za-z-]*))*))?'
semver_tag_pattern+='(\+([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?$'

resolve_python_command() {
  local candidate

  for candidate in python python3; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      command -v "${candidate}"
      return
    fi
  done

  printf '%s\n' \
    'pre-push: python is required to validate release artifacts.' >&2
  exit 1
}

main() {
  local local_object_id
  local local_ref
  local python_cmd=''
  local _remote_object_id
  local remote_ref
  local repo_root
  local tag_name

  repo_root="$(git rev-parse --show-toplevel)"

  while read -r local_ref local_object_id remote_ref _remote_object_id; do
    if [[ "${local_object_id}" == "${zero_object_id}" ||
      "${remote_ref}" != refs/tags/v* ]]; then
      continue
    fi

    tag_name="${remote_ref#refs/tags/}"
    if [[ ! "${tag_name}" =~ ${semver_tag_pattern} ]]; then
      printf 'pre-push: refusing non-SemVer release tag: %s\n' \
        "${tag_name}" >&2
      exit 1
    fi

    if [[ -z "${python_cmd}" ]]; then
      python_cmd="$(resolve_python_command)"
    fi

    printf 'pre-push: validating release artifacts for %s.\n' "${tag_name}"
    "${python_cmd}" "${repo_root}/tools/release-artifacts.py" check \
      --expected-ref "${tag_name}" \
      --treeish "${local_ref}^{commit}" \
      --repository-root "${repo_root}"
  done
}

main "$@"
