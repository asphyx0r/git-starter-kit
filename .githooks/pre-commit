#!/usr/bin/env bash
set -euo pipefail

staged_tree_dir=''

cleanup_staged_tree() {
  if [[ -n "${staged_tree_dir}" && -d "${staged_tree_dir}" ]]; then
    rm -rf -- "${staged_tree_dir}"
  fi
}

require_command() {
  local command_name="$1"
  local file_type="$2"

  if ! command -v "${command_name}" >/dev/null 2>&1; then
    printf 'pre-commit: %s is required for staged %s files.\n' "${command_name}" "${file_type}" >&2
    printf 'pre-commit: install %s or unstage the %s changes.\n' "${command_name}" "${file_type}" >&2
    exit 1
  fi
}

resolve_python_command() {
  local candidate

  for candidate in python python3; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      command -v "${candidate}"
      return
    fi
  done

  printf '%s\n' \
    'pre-commit: python is required for staged release artifacts.' >&2
  exit 1
}

run_markdownlint() {
  local staged_tree_root="$1"
  shift

  local -a staged_files=("$@")
  local -a lint_paths=()
  local file_path

  for file_path in "${staged_files[@]}"; do
    lint_paths+=("./${file_path}")
  done

  printf 'pre-commit: running markdownlint-cli2 on %d staged Markdown file(s).\n' "${#staged_files[@]}"
  (cd "${staged_tree_root}" && markdownlint-cli2 "${lint_paths[@]}")
}

run_yamllint() {
  local staged_tree_root="$1"
  shift

  local -a staged_files=("$@")
  local -a lint_paths=()
  local file_path

  for file_path in "${staged_files[@]}"; do
    lint_paths+=("./${file_path}")
  done

  printf 'pre-commit: running yamllint on %d staged YAML file(s).\n' "${#staged_files[@]}"
  (cd "${staged_tree_root}" && yamllint "${lint_paths[@]}")
}

run_release_artifact_check() {
  local staged_tree_root="$1"
  local repo_root="$2"
  local python_cmd="$3"
  local tool_path="${staged_tree_root}/tools/release-artifacts.py"

  if [[ ! -f "${tool_path}" ]]; then
    printf '%s\n' \
      'pre-commit: staged release artifacts require tools/release-artifacts.py.' \
      >&2
    exit 1
  fi

  printf '%s\n' \
    'pre-commit: validating staged VERSION, SHA256SUMS, and manifest.json.'
  "${python_cmd}" "${tool_path}" check \
    --index \
    --repository-root "${repo_root}"
}

main() {
  local repo_root
  local python_cmd=''
  local staged_file
  local -a staged_markdown_files=()
  local -a staged_release_artifacts=()
  local -a staged_yaml_files=()

  repo_root="$(git rev-parse --show-toplevel)"
  cd "${repo_root}"

  while IFS= read -r -d '' staged_file; do
    staged_markdown_files+=("${staged_file}")
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md')

  while IFS= read -r -d '' staged_file; do
    staged_yaml_files+=("${staged_file}")
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.yaml' '*.yml')

  while IFS= read -r -d '' staged_file; do
    staged_release_artifacts+=("${staged_file}")
  done < <(
    git diff --cached --name-only -z --diff-filter=ACDMR -- \
      VERSION SHA256SUMS manifest.json
  )

  if ((${#staged_release_artifacts[@]} != 0 && \
    ${#staged_release_artifacts[@]} != 3)); then
    printf '%s\n' \
      'pre-commit: VERSION, SHA256SUMS, and manifest.json must be staged together.' \
      >&2
    exit 1
  fi

  if ((${#staged_markdown_files[@]} == 0 && \
    ${#staged_yaml_files[@]} == 0 && \
    ${#staged_release_artifacts[@]} == 0)); then
    exit 0
  fi

  if ((${#staged_markdown_files[@]} > 0)); then
    require_command markdownlint-cli2 Markdown
  fi

  if ((${#staged_yaml_files[@]} > 0)); then
    require_command yamllint YAML
  fi

  if ((${#staged_release_artifacts[@]} > 0)); then
    python_cmd="$(resolve_python_command)"
  fi

  staged_tree_dir="$(mktemp -d)"
  trap cleanup_staged_tree EXIT

  git checkout-index -a --prefix="${staged_tree_dir}/"

  if ((${#staged_markdown_files[@]} > 0)); then
    run_markdownlint "${staged_tree_dir}" "${staged_markdown_files[@]}"
  fi

  if ((${#staged_yaml_files[@]} > 0)); then
    run_yamllint "${staged_tree_dir}" "${staged_yaml_files[@]}"
  fi

  if ((${#staged_release_artifacts[@]} > 0)); then
    run_release_artifact_check \
      "${staged_tree_dir}" \
      "${repo_root}" \
      "${python_cmd}"
  fi
}

main "$@"
